# Android signing material. NEVER in the repository — this one is public,
# and the signing key is the app's permanent identity on every phone: leak
# it and anyone can publish an update that Android accepts as yours.
*.jks
*.keystore
*.pepk
# The base64 of the key is the key. Same rules.
KEYSTORE_BASE64.txt
