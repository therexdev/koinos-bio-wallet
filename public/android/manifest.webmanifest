{
  "name": "Koinos Bio Wallet",
  "short_name": "Bio Wallet",
  "description": "A Koinos smart account sealed by your fingerprint. No password, no seed phrase, no fees.",
  "id": "/android/",
  "start_url": "/android/",
  "scope": "/android/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#121212",
  "theme_color": "#121212",
  "lang": "en",
  "categories": [
    "finance"
  ],
  "icons": [
    {
      "src": "/assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/assets/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Receive",
      "url": "/android/?open=receive",
      "description": "Show your address and QR code"
    },
    {
      "name": "Send",
      "url": "/android/?open=send",
      "description": "Send KOIN"
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "id": "wallet.koinos.app"
    }
  ],
  "prefer_related_applications": false
}
