<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press shortcuts, the same three the web manifest offers. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
  <shortcut android:shortcutId="receive" android:enabled="true" android:icon="@mipmap/ic_launcher"
      android:shortcutShortLabel="@string/shortcut_receive_short" android:shortcutLongLabel="@string/shortcut_receive_long">
    <intent android:action="android.intent.action.MAIN"
        android:targetPackage="com.usekoinos.biowallet"
        android:targetClass="com.google.androidbrowserhelper.trusted.LauncherActivity"
        android:data="https://wallet.usekoinos.com/?open=receive"/>
  </shortcut>
  <shortcut android:shortcutId="send" android:enabled="true" android:icon="@mipmap/ic_launcher"
      android:shortcutShortLabel="@string/shortcut_send_short" android:shortcutLongLabel="@string/shortcut_send_long">
    <intent android:action="android.intent.action.MAIN"
        android:targetPackage="com.usekoinos.biowallet"
        android:targetClass="com.google.androidbrowserhelper.trusted.LauncherActivity"
        android:data="https://wallet.usekoinos.com/?open=send"/>
  </shortcut>
  <shortcut android:shortcutId="buy" android:enabled="true" android:icon="@mipmap/ic_launcher"
      android:shortcutShortLabel="@string/shortcut_buy_short" android:shortcutLongLabel="@string/shortcut_buy_long">
    <intent android:action="android.intent.action.MAIN"
        android:targetPackage="com.usekoinos.biowallet"
        android:targetClass="com.google.androidbrowserhelper.trusted.LauncherActivity"
        android:data="https://wallet.usekoinos.com/?tab=convert"/>
  </shortcut>
</shortcuts>
